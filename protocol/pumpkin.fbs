namespace Pumpkin.Protocol;

table StartAudioStream {}

// Lights the candles again.
table StopAudioStream {}

table PlayShow {
  show_id:ushort;
}

table AudioChunk {
  pcm_s16le:[ubyte] (required);
}

table ResetAudio {}

table GetVolume {}

table AdjustVolume {
  delta:float;
}

table ListAudioFiles {}

table PlayAudioFile {
  name:string (required);
}

table BeginAudioUpload {
  name:string (required);
  size:uint;
}

// Sent as a request so the device's response doubles as the go-ahead for the
// next chunk, which is what keeps the client from running ahead of the card.
table AudioUploadChunk {
  bytes:[ubyte] (required);
}

// The checksum is CRC-32 (polynomial 0xEDB88320, initial and final value
// 0xFFFFFFFF) over every byte of the file. The device reads the stored file
// back and refuses it unless it matches, so a card that took the write but
// can't return it doesn't leave an unplayable file behind.
table FinishAudioUpload {
  checksum:uint;
}

table CancelAudioUpload {}

enum LightEffectId:ubyte {
  CANDLE = 0,
  AUDIO_REACTIVE = 1
}

struct Color {
  r:ubyte;
  g:ubyte;
  b:ubyte;
}

table Light {
  effect:LightEffectId = CANDLE;
  color:Color (required);
}

// Lights the pumpkin until something else does: another SetLight, a preset,
// or the end of what was playing, which lights the candles again. Changes
// nothing else, so it can go along with whatever needs it, like a voice
// streamed with lights that flare with it.
table SetLight {
  light:Light (required);
}

// Things the eye can do on its own. Nothing on the device plays these yet;
// they are here so presets can already say which one they want.
enum EyeEffectId:ubyte {
  // Leaves the eye doing whatever it was doing.
  NONE = 0,
  // Looks around at random.
  WANDER = 1,
  // Glances quickly from side to side.
  SHIFTY = 2,
  // Holds still, wide open.
  STARE = 3,
  // Closes and stays shut.
  SLEEP = 4
}

// Sets the whole scene at once. The preset itself lives with the client --
// the device only plays what it is sent -- so presets can be added or
// changed without touching the firmware.
table PlayPreset {
  // Absent leaves the lights as they are.
  light:Light;
  // A file in the SD card's audio directory, played in place of whatever is
  // playing. Absent stops what is playing and plays nothing.
  sound:string;
  eye:EyeEffectId = NONE;
}

// Turns the eye: negative is left, 0 straight ahead, positive right.
// Dragging a slider sends a stream of these and only the latest one matters,
// so the client sends them as messages rather than requests.
table MoveEye {
  at:byte;
}

// Opens or closes the eye lid: 0 is shut, 255 wide open. Sent the same way
// as MoveEye.
table MoveEyeLid {
  openness:ubyte = 255;
}

// The eye's two servos.
enum EyeServoId:ubyte {
  // Turns the eye from side to side.
  BALL = 0,
  // Opens and closes the lid over it.
  LID = 1
}

// The servo angles, 0-180, that the ends of an eye control map to: MoveEye's
// far left and far right for the ball, MoveEyeLid's shut and wide open for
// the lid. `min_angle` may be the larger of the two, for a servo that is
// mounted the other way round.
struct ServoRange {
  min_angle:ubyte;
  max_angle:ubyte;
}

// Holds a servo at a raw angle, 0-180, ignoring its calibration, so the ends
// of its range can be found by eye. Sent the same way as MoveEye.
table PreviewServoAngle {
  servo:EyeServoId;
  angle:ubyte;
}

table GetEyeCalibration {}

// Stores a servo's range on the device, where it survives a restart.
// MoveEye and MoveEyeLid move the eye by it from then on.
table SaveServoCalibration {
  servo:EyeServoId;
  range:ServoRange (required);
}

union ClientPayload {
  StartAudioStream,
  StopAudioStream,
  PlayShow,
  AudioChunk,
  ResetAudio,
  GetVolume,
  AdjustVolume,
  ListAudioFiles,
  PlayAudioFile,
  BeginAudioUpload,
  AudioUploadChunk,
  FinishAudioUpload,
  CancelAudioUpload,
  PlayPreset,
  MoveEye,
  MoveEyeLid,
  PreviewServoAngle,
  GetEyeCalibration,
  SaveServoCalibration,
  SetLight
}

table ClientMessage {
  request_id:uint;
  payload:ClientPayload (required);
}

table Success {}

enum ErrorCode:ubyte {
  UNKNOWN = 0,
  INVALID_MESSAGE = 1,
  UNSUPPORTED_MESSAGE = 2,
  INVALID_ARGUMENT = 3
}

table Error {
  code:ErrorCode = UNKNOWN;
  message:string (required);
}

table Volume {
  value:float;
}

table AudioFile {
  name:string (required);
  size:uint;
}

table AudioFileList {
  files:[AudioFile] (required);
}

// The ranges the eye's servos move by. A servo that has never been
// calibrated moves through all of 0-180.
table EyeCalibration {
  ball:ServoRange (required);
  lid:ServoRange (required);
}

// What the device has printed about itself, as its serial monitor shows it.
// Sent unasked, to every client: one that connects is first sent all the
// device still remembers, then each new line as it is printed.
table Log {
  // Picked afresh each time the device starts, so a client can tell the
  // device having restarted from it having reconnected.
  boot:uint;
  // Where `text` starts in everything logged since the device started, in
  // bytes. A client that reconnects is sent again what it already has, which
  // this is how to recognise; a gap after the last one means the client fell
  // so far behind that some of the log was lost.
  position:uint;
  // One or more whole lines, each ending in a newline. Each starts with how
  // long the device had been running when it was printed, as H:MM:SS.hh and
  // a space. A line too long for one message is split across several, and
  // only the first piece starts with the time.
  text:string (required);
  // How long the device had been running when it sent this, in microseconds.
  // The device has no clock of its own, so this is how a client works out
  // when it started, and from that the time of day each line was printed.
  uptime_us:ulong;
}

union ServerPayload {
  Success,
  Error,
  Volume,
  AudioFileList,
  EyeCalibration,
  Log
}

// A request_id of 0 marks a message that no request asked for.
table ServerMessage {
  request_id:uint;
  payload:ServerPayload (required);
}

union MessageBody {
  ClientMessage,
  ServerMessage
}

table Message {
  body:MessageBody (required);
}

root_type Message;
file_identifier "PKIN";